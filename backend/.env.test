# Environment used by the integration tests.
# This file is committed on purpose: it holds no real secret, only the
# credentials of the disposable `postgres-test` container (docker-compose.yml).
# Never point DATABASE_URL here at the development database (port 5432):
# the tests truncate every table before each test.

NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/helpa_test?schema=public"
JWT_SECRET="test-secret-com-pelo-menos-32-caracteres!!"
JWT_EXPIRES_IN="1h"
