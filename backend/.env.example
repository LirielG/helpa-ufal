DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="at-least-32-characters-random-secret-here!!"
JWT_EXPIRES_IN="1d"
CORS_ORIGIN="http://localhost:5173"
COOKIE_SAME_SITE="strict"
# Number of reverse proxies in front of the backend. Keep 0 for direct access.
TRUST_PROXY=0
# Each process keeps its own counters in memory; enable on the single backend instance.
RATE_LIMIT_ENABLED=true
# General quotas share a one-minute window across all routes.
RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_GLOBAL_PER_MINUTE=3000
ADMIN_EMAIL="admin@helpa.ufal.br"
ADMIN_PASSWORD="Admin@123"
ADMIN_FULL_NAME="Administrador"
ADMIN_REGISTRATION_CODE="SIAPE123456"
ADMIN_CNDB="CNDB123456"
ADMIN_COURSE="Ciência da Computação"
SIGAA_BASE_URL="https://sigaa.sig.ufal.br/sigaa/public/extensao/consulta_extensao.jsf"
SIGAA_CACHE_TTL_HOURS=12
SIGAA_SYNC_ENABLED=true
# Public frontend address, used in the certificate QR code (no trailing slash)
APP_PUBLIC_URL="http://localhost:5173"
# Transactional e-mail. Required only with NODE_ENV=production.
# Without SMTP_HOST in development/test, e-mails go to an Ethereal test
# account created on the first send; its preview URL is logged.
# SMTP_SECURE=true for implicit TLS (port 465); false uses STARTTLS.
# When omitted, it follows SMTP_PORT: true on 465, false on any other port.
# SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER="login@smtp-brevo.com"
# SMTP_PASS="smtp-password"
# Sender address, kept apart from SMTP_USER (it must be a verified sender)
MAIL_FROM="Helpa <no-reply@helpa.ufal.br>"
