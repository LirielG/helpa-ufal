# Copie este arquivo para `.env.local` se precisar apontar para outra API.
# Em desenvolvimento ele é opcional: sem a variável, `src/config/index.ts` usa
# http://localhost:3333, que é onde o backend deste repositório sobe.
#
# Toda variável exposta ao navegador precisa do prefixo VITE_, e o valor é
# embutido no bundle no momento do build — não coloque segredo aqui.

# URL base da API, sem barra no final.
# Desenvolvimento: http://localhost:3333
# O backend precisa autorizar esta origem no CORS_ORIGIN dele.
VITE_API_URL=http://localhost:3333
